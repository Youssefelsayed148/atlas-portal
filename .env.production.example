# Copy to .env.production and replace each placeholder. Use URL-safe characters
# for POSTGRES_PASSWORD because it is embedded in DATABASE_URL by Compose.
DOMAIN=portal.example.com
POSTGRES_PASSWORD=replace_with_a_long_url_safe_random_value
ATLAS_ADMIN_PASSWORD=replace_with_a_strong_admin_password
ATLAS_ADMIN_EMAIL=admin@atlas.local
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_chars
BETTER_AUTH_URL=https://portal.example.com
NEXT_PUBLIC_APP_URL=https://portal.example.com

# Optional: only used by the NLP query feature.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
